# Copy to .env and fill in real values. Never commit .env.

# --- Figma ---
# Personal Access Token (Figma > Settings > Security > Personal access tokens)
FIGMA_PAT=your_figma_personal_access_token_here
# File key from the design file URL: figma.com/file/<FILE_KEY>/...
FIGMA_FILE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Firebase / Firestore ---
FIREBASE_PROJECT_ID=iqm-ds-sync
# Path to the downloaded service account JSON (kept out of git — see .gitignore)
FIREBASE_SERVICE_ACCOUNT=./service-account.json
