{
  "name": "iqm-ds-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Sync layer for IQM's Figma design system — extracts tokens & components, stores them, diffs versions, and distributes docs/handoff. Phase 0 scaffolding.",
  "type": "module",
  "scripts": {
    "phase0": "node -e \"console.log('Phase 0 is scaffolding only — nothing to run yet.')\"",
    "extract:components": "node src/extract/run.js",
    "build:plugin": "esbuild src/plugin/code.ts --bundle --outfile=src/plugin/code.js",
    "test:store": "node src/store/local-db.test.js",
    "import:tokens": "node src/store/import-tokens.js",
    "test:diff": "node src/diff/diff.test.js",
    "export": "node src/export/build.js",
    "validate:export": "node src/export/validate.js",
    "test:export": "node src/export/export.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
